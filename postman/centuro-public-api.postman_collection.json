    {
      "name": "Case types",
      "item": [
        {
          "name": "List case types",
          "description": "Reference data: the kinds of case Centuro handles. Filter with `category` or search with `q`.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Body is the list envelope\", () => {",
                  "  pm.expect(body.data).to.be.an(\"array\");",
                  "  pm.expect(body.pagination.hasMore).to.be.a(\"boolean\");",
                  "  if (body.pagination.hasMore) pm.expect(body.pagination.nextCursor).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "pm.test(\"Has case types\", () => pm.expect(body.data.length).to.be.above(0));",
                  "body.data.slice(0, 5).forEach((t) => {",
                  "  pm.test(\"Case type \" + t.id + \" has the documented shape\", () => {",
                  "    pm.expect(t.id).to.match(/^[a-z0-9_-]+\\.[a-z0-9_.-]+$/);",
                  "    pm.expect(t.name).to.be.a(\"string\");",
                  "    pm.expect(t.category.id).to.be.a(\"string\");",
                  "  });",
                  "});",
                  "pm.test(\"Can be cached for an hour\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"max-age=3600\"));",
                  "pm.collectionVariables.set(\"caseTypeId\", body.data[0] ? body.data[0].id : \"\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiUrl}}/v1/case-types?limit=100",
              "host": [
