# Copy this file to .env and fill in the two values from your API key.
# .env is in .gitignore: never commit it.

# Your API key's client ID (starts with cg_) and its secret.
# The secret is shown once, when the key is created. If you've lost it, revoke the key and create a new one.
CENTURO_CLIENT_ID=
CENTURO_CLIENT_SECRET=

# Which Centuro environment to call. QAT is the test environment, and is the default.
CENTURO_API_URL=https://qat-api-goglobal.centuroglobal.com

# Optional. The scopes to ask for, separated by spaces. A token only carries the scopes you ask for.
# Default: cases:read
# CENTURO_SCOPES=cases:read
